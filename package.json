{
  "name": "honvelte-wind",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@honvelte/*' dev",
    "dev:web": "bun run --filter @honvelte/web dev",
    "dev:api": "bun run --filter @honvelte/api dev",
    "build": "bun run --filter @honvelte/contracts build && bun run --filter @honvelte/web build",
    "start": "bun run --filter @honvelte/api start",
    "check": "bun run --filter '*' check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit --audit-level=low",
    "test": "bun run --filter @honvelte/api test && bun run --filter @honvelte/contracts test",
    "test:coverage": "bun run --filter @honvelte/api test:coverage && bun run --filter @honvelte/contracts test:coverage",
    "test:db-examples": "bun test examples/databases",
    "test:auth-examples": "tsc --noEmit -p examples/auth/tsconfig.json && bun test examples/auth",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test -c tests/e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "bun run format:check && bun run audit && bun run lint && bun run check && bun run test:coverage && bun run build",
    "verify:all": "bun run verify && bun run test:db-examples && bun run test:auth-examples && bun run test:e2e",
    "agents:sync:claude": "bun run scripts/sync-agent-skills.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "deepmerge": "npm:@oss-cve-patches/deepmerge@4.3.2"
  }
}
