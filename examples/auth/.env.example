# Public origin used for exact Origin checks on state-changing requests.
APP_ORIGIN=https://app.example.com

# OIDC is optional. Configure only when an application uses an OIDC provider.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
