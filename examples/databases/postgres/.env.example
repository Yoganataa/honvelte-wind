# Use a dedicated database for the application.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/honvelte_wind

# Integration tests only; the test runner rejects database names without a _test suffix.
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/honvelte_wind_test

# Bun.SQL connection pool maximum (1-50).
PG_POOL_MAX=10
