NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info

# Bun HTTP server limits
SERVER_IDLE_TIMEOUT_SECONDS=30
SERVER_MAX_REQUEST_BODY_BYTES=1048576

# Time for load balancers to observe readiness=false before listener shutdown
SHUTDOWN_READINESS_DELAY_MS=1000

# Graceful shutdown deadline before active connections are closed
SHUTDOWN_TIMEOUT_MS=15000
