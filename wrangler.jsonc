{
  "name": "honvelte-wind",
  "main": "./apps/api/src/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "assets": {
    "directory": "./apps/web/dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "env": {
    "staging": {
      "name": "honvelte-wind-staging",
      "workers_dev": true,
    },
    "production": {
      "name": "honvelte-wind-production",
      "workers_dev": true,
    },
  },
}
