{
  "name": "honvelte-wind",
  "main": "./apps/api/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./apps/web/dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
